#!/usr/bin/env bash
# flights: letsfly's terminal commands and MCP server, each run in its own sandbox in Docker.
# Commands, isolation and links: README.md.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# Tags follow the content: if something changed and was not rebuilt, startup says so
IMAGE="lets-fly-core:$(cd "$HERE" && find src/letsfly docker -type f ! -path '*/__pycache__/*' -print0 | sort -z |
  xargs -0 sha256sum | sha256sum | cut -c1-12)"
PROXY_IMAGE="lets-fly-proxy:$(sha256sum "$HERE/docker/proxy.py" | cut -c1-12)"
ALLOW=www.google.com,promociones-aereas.com.ar
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/flights/egress.log"
LINKS="$HERE/local/flight-links"
SESSION="flights-$$-$RANDOM"
PROXY=http://proxy:3128

usage() {
  cat <<'USAGE'
usage: flights COMMAND [ARGS]

  search ORIGIN DESTINATION DATE [RETURN]      flights on one date, cheapest first
  dates ORIGIN DESTINATION START END [DAYS]    lowest price per departure date
  airports QUERY                               airports by code, city or name
  audit                                        live data checks: pair prices, dates, a burst
  mcp                                          the MCP server over stdio, for the flights agent
  update                                       pull this repo and reinstall: images, agent, skill
  build                                        rebuild both images after changing src/ or docker/
  image                                        tag of the core image
  test                                         offline tests inside the image
  selftest                                     live check: searches, MCP, network blocking, cleanup

search, dates and airports take --json (the reply as the agent gets it); COMMAND --help shows the rest.
USAGE
}

build() {
  docker build -f "$HERE/docker/Dockerfile" --target proxy -t "$PROXY_IMAGE" "$HERE"
  docker build -f "$HERE/docker/Dockerfile" --target core -t "$IMAGE" "$HERE"
}

save_log() {
  mkdir -p "$(dirname "$LOG")"
  docker logs "$1" 2>/dev/null | grep -v '^LISTEN' >> "$LOG" || true
}

# Leftovers of a run that died without cleaning up (kill -9, power cut): its process is gone
sweep() {
  local id pid role
  docker ps -a --filter label=flights.pid --format '{{.ID}} {{.Label "flights.pid"}} {{.Label "flights.role"}}' |
    while read -r id pid role; do
      kill -0 "$pid" 2>/dev/null && continue
      [ "$role" = proxy ] && save_log "$id"
      docker rm -f "$id" >/dev/null 2>&1 || true
    done
  docker network ls --filter label=flights.pid --format '{{.ID}} {{.Label "flights.pid"}}' |
    while read -r id pid; do kill -0 "$pid" 2>/dev/null || docker network rm "$id" >/dev/null 2>&1 || true; done
}

cleanup() {
  save_log "$SESSION-proxy"
  docker rm -f "$SESSION-core" "$SESSION-proxy" >/dev/null 2>&1 || true
  docker network rm "$SESSION" >/dev/null 2>&1 || true
}

start_proxy() {
  docker run -d --rm --init --pull never --name "$SESSION-proxy" --label "flights.pid=$$" --label flights.role=proxy \
    --cap-drop=ALL --security-opt=no-new-privileges --read-only --memory=128m --pids-limit=64 \
    "$PROXY_IMAGE" 3128 "$ALLOW" "$SESSION" >/dev/null
  docker network connect --alias proxy "$SESSION" "$SESSION-proxy"
}

# $1: mcp or cli. The rest is the command inside the container
run_core() {
  local mode="$1" opts=()
  shift
  if [ "$mode" = mcp ]; then
    opts=(-i)
  elif [ -t 1 ]; then
    opts=(-e "COLUMNS=$(tput cols 2>/dev/null || echo 120)" -e FORCE_COLOR=1)
  fi
  docker run --rm --init --pull never "${opts[@]}" --name "$SESSION-core" --label "flights.pid=$$" \
    --network "$SESSION" -e "HTTPS_PROXY=$PROXY" -e "https_proxy=$PROXY" -e "HTTP_PROXY=$PROXY" -e "http_proxy=$PROXY" \
    -e "FLIGHTS_LINKS=$LINKS" --read-only --tmpfs /tmp:size=64m --cap-drop=ALL --security-opt=no-new-privileges \
    --memory=512m --pids-limit=128 \
    "$IMAGE" "$@" 2> >(python3 -I "$HERE/src/letsfly/links.py" "$LINKS")
}

case "${1:-}" in
  build) build; exit ;;
  image) echo "$IMAGE"; exit ;;
  selftest) exec python3 -I "$HERE/tests/selftest.py" "$HERE/bin/flights" ;;
  test) shift; exec "$HERE/tests/run.sh" "$IMAGE" "$@" ;;
  # exec, because the pull may rewrite this very script while bash is still reading it
  update) exec sh -c 'git -C "$1" pull --ff-only && "$1/install.sh"' sh "$HERE" ;;
  "" | -h | --help | help) usage; exit ;;
esac

sweep
trap cleanup EXIT
docker network create --internal --label "flights.pid=$$" "$SESSION" >/dev/null

# The core starts first and the proxy comes up meanwhile. docker runs in the background so that a
# signal (Claude Code stops the MCP with SIGTERM) reaches this script, which removes the containers
# right away. The MCP needs its stdin, passed through fd 3
if [ "$1" = mcp ]; then
  exec 3<&0
  run_core mcp python -I -m letsfly.tools <&3 &
else
  run_core cli python -I -m letsfly "$@" &
fi
child=$!
trap 'cleanup; kill -TERM "$child" 2>/dev/null || true' TERM INT HUP
if ! start_proxy; then
  echo "flights: the proxy did not start; if the images are missing, run: flights build" >&2
  cleanup
  exit 1
fi
rc=0
wait "$child" || rc=$?
# A signal interrupts the first wait; the second one waits for docker to really finish
if kill -0 "$child" 2>/dev/null; then wait "$child" || rc=$?; fi
# 125 is a docker error before the core starts, almost always a missing image
[ "$rc" != 125 ] || echo "flights: if the image $IMAGE is missing, run: flights build" >&2
exit "$rc"
